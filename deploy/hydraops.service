# hydraops.service — HydraOps as a systemd service (headless mode).
#
# It assumes a clone of the repository already prepared AS THE SERVICE USER
# (pnpm install, pnpm build, pnpm --filter ui build, a .env with HYDRA_HOST
# and HYDRA_AUTH_TOKEN) and the nats-server binary reachable (on the system
# PATH or through NATS_SERVER_BIN, below).
#
# Installation — first adjust User=, WorkingDirectory=, ExecStart= and
# ReadWritePaths= to your user and the path of your clone:
#
#   sudo cp deploy/hydraops.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydraops
#
# Logs:    journalctl -u hydraops -f     (each line carries its [service])
# Status:  systemctl status hydraops
# Stop:    sudo systemctl stop hydraops  (SIGTERM → the whole stack stops cleanly)

[Unit]
Description=HydraOps — multi-agent stack (NATS, key-proxy, API and workers)
Documentation=https://github.com/TraX22/HydraOps
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# The user that owns the stack. Their API keys live in
# ~/.config/hydraops/keys.json — the key-proxy manages them, not this file.
User=hydraops
Group=hydraops

# The root of the clone.
WorkingDirectory=/home/hydraops/HydraOps
# `which node` tells the path of node; the script path must be absolute.
ExecStart=/usr/bin/node /home/hydraops/HydraOps/tools/serve.mjs

# If nats-server is not on the PATH systemd sees (/usr/bin, /usr/local/bin):
#Environment=NATS_SERVER_BIN=/usr/local/bin/nats-server

# serve.mjs stops the whole stack on SIGTERM; with "mixed", systemd sends it
# only to the main process (the orderly shutdown does the rest) and finishes
# with SIGKILL whatever is still alive after the timeout.
KillMode=mixed
TimeoutStopSec=30

# serve exits with an error when NATS, the key-proxy or the API fail to start;
# a clean stop (systemctl stop) is not retried.
Restart=on-failure
RestartSec=5

# Hardening: read-only file system except what the stack really writes — the
# clone (database, storage/, logs, nats/jetstream) and the user's key store.
# If you move the data with HYDRA_DATA_DIR, add that path here.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hydraops/HydraOps
ReadWritePaths=/home/hydraops/.config/hydraops

[Install]
WantedBy=multi-user.target
