# hydraops.service — HydraOps as a systemd service (headless mode).
#
# It assumes a clone of the repository already prepared AS THE SERVICE USER
# (pnpm install, pnpm build, pnpm --filter ui build, a .env with HYDRA_HOST
# and HYDRA_AUTH_TOKEN) and the nats-server binary reachable (on the system
# PATH or through NATS_SERVER_BIN, below).
#
# Installation — first adjust User=, WorkingDirectory=, ExecStart=,
# Environment=PATH and ReadWritePaths= to your user and the path of your clone:
#
#   mkdir -p ~/.cache ~/.local/share ~/.npm ~/.config/comfy-cli ~/.config/HydraOps   # as the service user: the folders below
#   sudo cp deploy/hydraops.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydraops
#
# Logs:    journalctl -u hydraops -f     (each line carries its [service])
# Status:  systemctl status hydraops
# Stop:    sudo systemctl stop hydraops  (SIGTERM → the whole stack stops cleanly)

[Unit]
Description=HydraOps — multi-agent stack (NATS, key-proxy, API and workers)
Documentation=https://github.com/TraX22/HydraOps
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# The user that owns the stack. Their API keys live in
# ~/.config/hydraops/keys.json — the key-proxy manages them, not this file.
User=hydraops
Group=hydraops

# The root of the clone.
WorkingDirectory=/home/hydraops/HydraOps
# `which node` tells the path of node; the script path must be absolute.
ExecStart=/usr/bin/node /home/hydraops/HydraOps/tools/serve.mjs

# If nats-server is not on the PATH systemd sees (/usr/bin, /usr/local/bin):
#Environment=NATS_SERVER_BIN=/usr/local/bin/nats-server

# Connections (MCP servers) are started with uvx or npx. systemd's PATH does not
# include the user's ~/.local/bin, where uv installs itself, so it is added here.
Environment=PATH=/home/hydraops/.local/bin:/usr/local/bin:/usr/bin:/bin

# serve.mjs stops the whole stack on SIGTERM; with "mixed", systemd sends it
# only to the main process (the orderly shutdown does the rest) and finishes
# with SIGKILL whatever is still alive after the timeout.
KillMode=mixed
TimeoutStopSec=30

# serve exits with an error when NATS, the key-proxy or the API fail to start;
# a clean stop (systemctl stop) is not retried. After a self-update (the
# "Update" button) it exits with code 3 on purpose, so that systemd starts a
# fresh supervisor running the new code: that exit is a success, and it restarts.
Restart=on-failure
RestartSec=5
SuccessExitStatus=3
RestartForceExitStatus=3

# Hardening: read-only file system except what the stack really writes — the
# clone (database, storage/, logs, nats/jetstream), the user's key store, and
# the caches where uvx and npx keep the connections' servers (without them a
# connection never starts). If you move the data with HYDRA_DATA_DIR, add that
# path here.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hydraops/HydraOps
ReadWritePaths=/home/hydraops/.config/hydraops
# The leading "-" lets the service start when a folder does not exist yet — but a
# folder skipped that way stays read-only, so create them before the first start.
ReadWritePaths=-/home/hydraops/.cache
ReadWritePaths=-/home/hydraops/.local/share
ReadWritePaths=-/home/hydraops/.npm
# The ComfyUI connection (comfy-cli) records every job it submits under
# ~/.config/comfy-cli; read-only, run_workflow fails after ComfyUI already took
# the job ("Read-only file system: ~/.config/comfy-cli/jobs").
ReadWritePaths=-/home/hydraops/.config/comfy-cli
# The copies of the installation (System -> Backups, and the one made before every
# update) live outside the clone, in ~/.config/HydraOps/backups: without this line the
# update from the app stops at "the copy could not be made". Create the folder first.
ReadWritePaths=-/home/hydraops/.config/HydraOps

[Install]
WantedBy=multi-user.target
