# Copia este archivo a .env y ajusta lo que necesites.
#
# IMPORTANTE — las claves de API no van aquí. HydraOps las guarda fuera del
# proyecto (en %APPDATA%\hydraops\keys.json en Windows) y las inyecta el
# key-proxy en la frontera de red, de modo que ni los workers ni la base de
# datos ni este archivo llegan a ver una clave real. Para configurarlas, usa la
# vista Configuración de la aplicación.
#
# El valor literal "proxy" es un marcador: significa "esta clave existe, pídesela
# al key-proxy". Déjalo tal cual en los proveedores que uses.

# ─── Infraestructura ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
NATS_URL=nats://127.0.0.1:4222
LOG_LEVEL=info

# Ruta al binario de nats-server, solo si no está en el PATH ni en una carpeta
# nats/ del repositorio (el arranque lo busca en ese orden).
NATS_SERVER_BIN=

# Interfaz en la que escucha la API. Por defecto solo loopback: nadie fuera de
# esta máquina la alcanza. Ponlo a 0.0.0.0 para abrir la interfaz a tu red
# local — y eso exige definir HYDRA_AUTH_TOKEN: sin token, la API se niega a
# abrirse y se queda en loopback (lo dice en el log).
HYDRA_HOST=127.0.0.1
PORT=3000

# Token de acceso cuando la interfaz se abre a la red. Largo y aleatorio, por
# ejemplo el resultado de:  node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
# El navegador lo pide una vez (pantalla de login) y lo recuerda en una cookie;
# los scripts pueden mandarlo como cabecera "Authorization: Bearer <token>".
# Las conexiones desde esta misma máquina (escritorio, desarrollo) no lo
# necesitan. OJO: viaja en claro por HTTP — está pensado para tu red local, no
# para exponer el puerto a internet.
HYDRA_AUTH_TOKEN=

# Ponlo a 1 solo si la API vive detrás de un proxy inverso: ahí todo el tráfico
# parece local y el token debe exigirse también a esas conexiones.
HYDRA_AUTH_STRICT=

# ─── Cortafuegos de credenciales ──────────────────────────────────────────────
KEY_PROXY_URL=http://127.0.0.1:9099

# ─── Proveedores de modelos ───────────────────────────────────────────────────
# Deja "proxy" en los que uses; vacío en los que no.
OPENAI_API_KEY=proxy
ANTHROPIC_API_KEY=proxy
GEMINI_API_KEY=proxy
GROQ_API_KEY=
XAI_API_KEY=proxy
LEONARDO_API_KEY=proxy
OPENROUTER_API_KEY=proxy
MISTRAL_API_KEY=proxy
DEEPSEEK_API_KEY=proxy
QWEN_API_KEY=proxy
KIMI_API_KEY=proxy
MINIMAX_API_KEY=proxy
# GLM (Z.ai): para gastar el plan plano usa una key con prefijo sk-sp-; una key
# sk- normal factura por token. La clave se pone en la vista Configuración.
GLM_API_KEY=proxy
# Brave Search API — la usa la herramienta web_search de los agentes. Consigue
# una key gratis en https://brave.com/search/api y pégala en Configuración →
# Brave Search. Se guarda en el almacén de claves; aquí solo va el placeholder.
BRAVE_API_KEY=proxy

# ─── Modelo local (llama.cpp, LM Studio, vLLM, Ollama…) ───────────────────────
# Estos tres SOLO viven aquí: la aplicación los borra a propósito de la base de
# datos para que no puedan tapar a este archivo. Los workers releen el .env en
# cada tarea, así que cambiarlos surte efecto sin reiniciar nada.
#
# Vacío = no hay servidor local configurado (y la app lo dirá con esas palabras
# en vez de intentar conectarse a un puerto que nunca escribiste).
# Ejemplos: http://127.0.0.1:8080/v1 (llama-server) · http://127.0.0.1:1234/v1 (LM Studio)
LOCAL_LLM_URL=
LOCAL_LLM_KEY=
LOCAL_LLM_MODEL=

# ─── Modelo por defecto ───────────────────────────────────────────────────────
# Se usa cuando un agente está en "Automático". Déjalo VACÍO: así el usuario
# elige el modelo por defecto desde la vista Configuración una vez que añade sus
# claves (no se fuerza ningún proveedor). "local-model" es un alias estable que
# apunta a lo que sirva LOCAL_LLM_URL en ese momento.
DEFAULT_MODEL=
