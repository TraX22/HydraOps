{
  "name": "@hydraops/nats",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist"
  },
  "dependencies": {
    "nats": "^2.29.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "types": "./src/index.ts"
}
