{
  "name": "@hydraops/db",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/migrate.ts src/seed-agent-configs.ts --format esm --out-dir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed-agent-configs.ts"
  },
  "dependencies": {
    "@hydraops/config": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "types": "./src/index.ts"
}
